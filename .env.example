# Zohra ClipOS — development example only. Never commit real credentials.
CLIPOS_ENVIRONMENT=development
CLIPOS_SECRET_KEY=replace-with-at-least-32-random-characters
CLIPOS_JWT_ISSUER=zohra-clipos
CLIPOS_JWT_AUDIENCE=clipos-api
CLIPOS_DATABASE_URL=sqlite+aiosqlite:///./data/clipos.db
CLIPOS_AUTO_CREATE_SCHEMA=true
CLIPOS_QUEUE_BACKEND=memory
CLIPOS_REDIS_URL=redis://localhost:6379/0
CLIPOS_REDIS_REQUIRED=false
CLIPOS_STORAGE_BACKEND=local
CLIPOS_STORAGE_LOCAL_ROOT=./data/storage
CLIPOS_UPLOAD_TEMP_ROOT=./data/tmp
CLIPOS_MAX_UPLOAD_BYTES=2147483648
CLIPOS_MAX_MEDIA_DURATION_SECONDS=21600
CLIPOS_MAX_DERIVED_AUDIO_BYTES=2147483648
CLIPOS_FFMPEG_PATH=ffmpeg
CLIPOS_FFPROBE_PATH=ffprobe
CLIPOS_EMBEDDED_WORKER_ENABLED=true
CLIPOS_WORKER_STALE_JOB_SECONDS=1800

# Phase 4 validated rendering. Temp files must remain outside private object storage.
CLIPOS_RENDERING_ENABLED=true
CLIPOS_RENDER_TEMP_ROOT=./data/render-tmp
CLIPOS_RENDER_MAX_DURATION_SECONDS=180
CLIPOS_RENDER_MAX_WIDTH=3840
CLIPOS_RENDER_MAX_HEIGHT=3840
CLIPOS_RENDER_MAX_PIXELS=8294400
CLIPOS_RENDER_MAX_FRAME_RATE=60
CLIPOS_RENDER_TIMEOUT_SECONDS=900
CLIPOS_RENDER_MAX_OUTPUT_BYTES=1073741824
CLIPOS_RENDER_MIN_FREE_DISK_BYTES=536870912
CLIPOS_RENDER_DURATION_TOLERANCE_SECONDS=0.5
CLIPOS_RENDER_MAX_ACTIVE_PER_TENANT=2
CLIPOS_RENDER_MAX_QUEUED_PER_TENANT=20
CLIPOS_RENDER_MAX_ATTEMPTS=3
CLIPOS_RENDER_MAX_CAPTION_SEGMENTS=250
CLIPOS_RENDER_CAPTION_MAX_CHARS_PER_LINE=42
CLIPOS_RENDER_CAPTION_MAX_LINES=2
CLIPOS_RENDER_CAPTION_MAX_CUE_SECONDS=4
CLIPOS_RENDER_OUTPUT_AUDIO_SAMPLE_RATE=48000
CLIPOS_RENDER_OUTPUT_AUDIO_CHANNELS=2
CLIPOS_RENDER_TARGET_LUFS=-16
CLIPOS_RENDER_TRUE_PEAK_DB=-1.5
CLIPOS_RENDER_X264_PRESET=medium
CLIPOS_RENDER_CRF=20

# Phase 5 gate evidence is short-lived and always rechecked against current server state.
CLIPOS_QUALITY_MIN_CONFIDENCE=0.7
CLIPOS_QUALITY_APPROVAL_TTL_MINUTES=1440
CLIPOS_QUALITY_PREFLIGHT_TTL_SECONDS=300

# Phase 6 publishing is fail-closed. Keep disabled until an operator has configured an
# official Google OAuth web client, registered this exact callback, and injected secrets.
# Configuration is not proof of a successful real OAuth or upload.
CLIPOS_YOUTUBE_PUBLISHING_ENABLED=false
CLIPOS_ANALYTICS_PROVIDER=disabled
CLIPOS_YOUTUBE_ANALYTICS_ENABLED=false
# Phase 8 opportunity discovery is fail-closed. RSS fetching makes outbound requests and
# stays disabled until an operator enables it; every fetch still passes the SSRF guard.
# The fake opportunity provider is for tests/local demos only and is always reported mocked.
CLIPOS_OPPORTUNITY_PROVIDER=disabled
CLIPOS_OPPORTUNITY_RSS_ENABLED=false
# Phase 9 sales/CRM gateways are fail-closed: no email, calendar or payment provider
# has been chosen yet, so only "disabled" and the test/local "fake" are valid values.
# Naming a real provider is a configuration error until those provider decisions are
# made and a provider is reviewed and integrated. Drafts are never sent in Phase 9.
CLIPOS_COMMS_PROVIDER=disabled
CLIPOS_PAYMENTS_PROVIDER=disabled
CLIPOS_PUBLISHING_PUBLIC_ENABLED=false
CLIPOS_PUBLISHING_TOKEN_ENCRYPTION_KEY=
CLIPOS_PUBLISHING_OAUTH_STATE_TTL_SECONDS=600
CLIPOS_PUBLISHING_TOKEN_REFRESH_SKEW_SECONDS=300
CLIPOS_PUBLISHING_HTTP_TIMEOUT_SECONDS=60
# Must be a multiple of 262144 (256 KiB).
CLIPOS_PUBLISHING_UPLOAD_CHUNK_BYTES=8388608
CLIPOS_PUBLISHING_MAX_ACTIVE_PER_TENANT=2
CLIPOS_PUBLISHING_MAX_QUEUED_PER_TENANT=20
CLIPOS_PUBLISHING_MAX_ATTEMPTS=3
CLIPOS_PUBLISHING_DAILY_UPLOAD_LIMIT=20
CLIPOS_PUBLISHING_PROCESSING_POLL_SECONDS=2
CLIPOS_PUBLISHING_PROCESSING_MAX_POLLS=5
CLIPOS_YOUTUBE_CLIENT_ID=
CLIPOS_YOUTUBE_CLIENT_SECRET=
CLIPOS_YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/publishing/oauth/youtube/callback
CLIPOS_YOUTUBE_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
CLIPOS_YOUTUBE_TOKEN_URL=https://oauth2.googleapis.com/token
CLIPOS_YOUTUBE_REVOCATION_URL=https://oauth2.googleapis.com/revoke
CLIPOS_YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3
CLIPOS_YOUTUBE_UPLOAD_BASE_URL=https://www.googleapis.com/upload/youtube/v3

# S3 remains intentionally unavailable; names are reserved for a later reviewed adapter.
CLIPOS_S3_ENDPOINT_URL=
CLIPOS_S3_BUCKET=
CLIPOS_S3_ACCESS_KEY_ID=
CLIPOS_S3_SECRET_ACCESS_KEY=
CLIPOS_CORS_ORIGINS=["http://localhost:3000"]
CLIPOS_TRUSTED_HOSTS=["localhost","127.0.0.1","testserver","*.e2b.app"]
# Phase 3 model selection is optional. Deterministic discovery works while disabled.
# If enabled, set the matching key/model and explicitly confirm current cost rates.
CLIPOS_MODEL_PROVIDER=disabled
CLIPOS_MODEL_TIMEOUT_SECONDS=45
CLIPOS_MODEL_MAX_RETRIES=2
CLIPOS_MODEL_REQUEST_MAX_INPUT_CHARS=80000
CLIPOS_MODEL_REQUEST_MAX_OUTPUT_TOKENS=4096
CLIPOS_MODEL_RESPONSE_MAX_BYTES=4194304
CLIPOS_MODEL_RESPONSE_MAX_CHARS=1000000
CLIPOS_TRANSCRIPTION_PROVIDER=disabled
CLIPOS_TRANSCRIPTION_MODEL=
CLIPOS_TRANSCRIPTION_RESPONSE_MAX_BYTES=67108864
CLIPOS_TRANSCRIPT_MAX_TEXT_CHARS=5000000
CLIPOS_TRANSCRIPT_MAX_SEGMENTS=50000
CLIPOS_TRANSCRIPT_MAX_WORDS=150000
CLIPOS_TRANSCRIPT_CONFIDENCE_REVIEW_THRESHOLD=0.55
CLIPOS_OPENAI_API_KEY=
CLIPOS_OPENAI_BASE_URL=https://api.openai.com/v1
CLIPOS_OPENAI_MODEL=
CLIPOS_ANTHROPIC_API_KEY=
CLIPOS_ANTHROPIC_MODEL=
CLIPOS_MODEL_INPUT_COST_PER_MILLION=0
CLIPOS_MODEL_OUTPUT_COST_PER_MILLION=0
# Confirm only after checking the selected provider/model price; true also confirms deliberate free rates.
CLIPOS_MODEL_COST_RATES_CONFIRMED=false

# Explainable candidate planning and per-run provider budget.
CLIPOS_DISCOVERY_MIN_DURATION_SECONDS=15
CLIPOS_DISCOVERY_TARGET_DURATION_SECONDS=35
CLIPOS_DISCOVERY_MAX_DURATION_SECONDS=60
CLIPOS_DISCOVERY_PADDING_SECONDS=1
CLIPOS_DISCOVERY_MAX_CANDIDATES=12
CLIPOS_DISCOVERY_POOL_MULTIPLIER=3
CLIPOS_DISCOVERY_OVERLAP_THRESHOLD=0.75
CLIPOS_DISCOVERY_SIMILARITY_THRESHOLD=0.86
CLIPOS_DISCOVERY_MAX_EXCERPT_CHARS=50000
CLIPOS_DISCOVERY_MODEL_MAX_INPUT_CHARS=40000
CLIPOS_DISCOVERY_MODEL_MAX_OUTPUT_TOKENS=2048
CLIPOS_DISCOVERY_MODEL_COST_CAP=0.25
CLIPOS_LOG_LEVEL=INFO
CLIPOS_RATE_LIMIT_PER_MINUTE=120

# Web server-side proxy target (never sent to the browser).
CLIPOS_API_INTERNAL_URL=http://localhost:8000
